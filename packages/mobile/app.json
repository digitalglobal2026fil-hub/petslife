{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.petislife2.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#5BB8B5"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 63,
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "apiUrl": "https://qx7w0z1uul79my5hxm5d2-preview-4200.runable.site/",
      "eas": {
        "projectId": "1cf237a5-8621-4e30-80b9-90145a80262c"
      },
      "applicationId": "qx7w0z1uul79my5hxm5d2",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.petislife2.app",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/digitalglobal-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#05060F"
    },
    "name": "PetsLife",
    "slug": "petslife",
    "version": "1.9.30",
    "scheme": "runable-qx7w0z1uul79my5hxm5d2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A PetsLife precisa de acesso às suas fotos para carregar documentos do seu animal.",
          "cameraPermission": "A PetsLife precisa de acesso à câmara para fotografar documentos."
        }
      ],
      "expo-iap",
      "expo-audio"
    ]
  }
}