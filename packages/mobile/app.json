{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.petslife.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 8
    },
    "extra": {
      "apiUrl": "https://qx7w0z1uul79my5hxm5d2-preview-4200.runable.site/",
      "eas": {
        "projectId": "1cf237a5-8621-4e30-80b9-90145a80262c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.petslife.app",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FF6B35"
    },
    "name": "PetsLife",
    "slug": "petslife",
    "version": "1.2.0",
    "scheme": "petslife",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A PetsLife precisa de acesso às suas fotos para carregar documentos do seu animal.",
          "cameraPermission": "A PetsLife precisa de acesso à câmara para fotografar documentos."
        }
      ]
    ]
  }
}
